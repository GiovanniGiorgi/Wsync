#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════════
#  wsync — sync manuale stile git con nastro di snapshot (foto hardlink)
#
#  ▸ Il mondo:  cartella remota  <->  ./workingdir/  + nastro snapshot
#  ▸ Flusso:    pull → lavoro → status/diff → push
#  ▸ Nastro:    server-<ts>    foto del server (al pull, e alla diff se drift)
#               server-<ts>-E  file del server "vittimi" del push (recuperati)
#               push-<ts>      mondo riconciliato (data = push)
#               local-<ts>     salvataggio d'emergenza di lavoro non pushato
#
#  Ogni ciclo:  PULL  → workingdir := server + foto R₁ (riferimento del ciclo)
#               STATUS→ i TUOI cambi vs R₁ (solo locale, istantaneo)
#               DIFF  → deriva del server vs ultima foto (se c'è → nuova foto)
#               PUSH  → guardiani + rsync con --backup (vittime → -E) + foto S
# ════════════════════════════════════════════════════════════════════
set -euo pipefail

# ─── COSTANTI (modificare qui) ──────────────────────────────────────
SSH_HOST="myserver"                    # nome host definito in ~/.ssh/config (vuoto = percorso locale)
REMOTE_DIR="/path/to/remote/project"  # cartella remota da sincroniare (path assoluto)
KEEP=60                                         # snapshot da conservare (wsync keep N)
EXCLUDES=()                                     # esclusioni rsync, es: (--exclude=.cache)
# ────────────────────────────────────────────────────────────────────

BASE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
WD="$BASE/workingdir"
CYCLE="$BASE/.wsync-cycle"                      # puntatore alla foto R₁ del ciclo
TS()   { date +%Y-%m-%d_%H%M%S; }
RPATH(){ echo "${SSH_HOST:+$SSH_HOST:}$1"; }    # path rsync (host:path o path)
REMOTE_URL="$(RPATH "$REMOTE_DIR")/"
STAGE_PARENT="$(dirname "$REMOTE_DIR")"         # dove il server appoggia le staging-dir

# remoto: esegue un comando (via ssh o locale)
rsh() { if [[ -n "$SSH_HOST" ]]; then ssh -o BatchMode=yes -o ConnectTimeout=8 "$SSH_HOST" "$@"; else bash -c "$@"; fi; }

# ordinamento cronologico VERO: per timestamp incorporato nel nome, non lessicale
_byts() { local d t; for d in "$@"; do [[ -d "$d" ]] || continue
  t=$(basename "$d" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{6}'); echo "$t  $d"; done | sort; }
latest()  { _byts "$BASE"/{server-*,push-*} 2>/dev/null | grep -vE ' \S+-E$' | tail -1 | sed 's/^[^ ]*  //' || true; }
latest_p(){ _byts "$BASE"/push-* 2>/dev/null | tail -1 | sed 's/^[^ ]*  //' || true; }
cycle_ref(){ [[ -f "$CYCLE" ]] && cat "$CYCLE" || latest_p; }

# differenza (metadati, dry-run) tra <src/> e <ref/> → liste di righe non vuote
changes() { rsync -ain --delete "$1" "$2" "${EXCLUDES[@]}" 2>/dev/null | grep -E '^(<|>|\*deleting)' | grep -v '/$' || true; }

photo() { # photo <nome> <sorgente-rsync>
  local dest="$BASE/$1" src="$2" prev link=()
  prev="$(latest)"; [[ -n "$prev" ]] && link=(--link-dest="$prev")
  mkdir -p "$dest"
  rsync -a "${link[@]}" "${EXCLUDES[@]}" --delete "$src" "$dest/"
}

ask() { # ask "domanda" → 0=yes ; NO=WSYNC_YES=1 force-sì
  [[ "${WSYNC_YES:-0}" == 1 ]] && { echo "$1 [SÌ auto]"; return 0; }
  [[ ! -t 0 ]] && { echo "⛔ $1 → (non interattivo: abortisco; WSYNC_YES=1 per forzare)"; return 1; }
  local a; read -r -p "$1 [s/N] " a; [[ "$a" =~ ^[sS]$ ]]
}

# ─── COMANDI ─────────────────────────────────────────────────────────
cmd="${1:-help}"
case "$cmd" in

init)
  echo "🔧 init: host='${SSH_HOST:-<locale>}' remote=$REMOTE_URL"
  rsh "test -d '$REMOTE_DIR'" || { echo "⛔ la cartella remota non esiste"; exit 1; }
  mkdir -p "$WD"
  echo "✅ workingdir pronta in ${WD#$BASE/} — primo passo: wsync pull"
  ;;

status)
  ref="$(cycle_ref)"
  [[ -z "$ref" ]] && { echo "(nessun riferimento: fai prima un pull)"; exit 0; }
  echo "── I TUOI cambi (workingdir vs ${ref#$BASE/}) ──"
  out="$(changes "$WD/" "$ref/")"
  [[ -z "$out" ]] && echo "   (nessuno)" || echo "$out" | sed 's/^/   /'
  ;;

diff)
  last="$(latest)"
  echo "── DERIVA DEL SERVER (vs ${last:-nessuna foto} ${last:+${last#$BASE/}}) ──"
  if [[ -z "$last" ]]; then
    echo "   (nessuna foto precedente)"
  else
    drift="$(changes "$REMOTE_URL" "$last/")"
    if [[ -z "$drift" ]]; then
      echo "   (nessuna — il server è fermo dall'ultima foto)"
    else
      echo "$drift" | sed 's/^/   /'
      name="server-$(TS)"; photo "$name" "$REMOTE_URL"
      echo "📸 drift rilevato → nuova foto: $name"
      echo "   dettagli: wsync diff-snap ${last#$BASE/} $name"
    fi
  fi
  echo
  "$0" status
  ;;

pull)
  # guardiano: workingdir sporca rispetto al riferimento del ciclo?
  ref="$(cycle_ref)"
  if [[ -n "$ref" ]]; then
    dirty="$(changes "$WD/" "$ref/")"
    if [[ -n "$dirty" ]]; then
      echo "⚠️  La working dir ha modifiche non pushate:"
      echo "$dirty" | head -20 | sed 's/^/   /'
      if ask "Salvarle in uno snapshot d'emergenza (local-<ts>) e procedere?"; then
        name="local-$(TS)"; photo "$name" "$WD/"
        echo "🛟 salvataggio: $name"
      else echo "abortito."; exit 1
      fi
    fi
  fi
  # 1) foto del server (unica lettura della remota: workingdir == foto garantita)
  name="server-$(TS)"; photo "$name" "$REMOTE_URL"
  # 2) cross-check fuori ciclo: il server è cambiato dall'ultimo push?
  lp="$(latest_p)"
  if [[ -n "$lp" ]]; then
    cross="$(changes "$REMOTE_URL" "$lp/")"
    [[ -n "$cross" ]] && { echo "⚠️  il server è mutato DOPO l'ultimo push (${lp#$BASE/}):"
                          echo "$cross" | head -20 | sed 's/^/   /'; }
  fi
  # 3) workingdir := foto
  mkdir -p "$WD"
  rsync -a --delete "$BASE/$name/" "$WD/" "${EXCLUDES[@]}"
  echo "$BASE/$name" > "$CYCLE"
  echo "✅ pull: workingdir = server  (riferimento ciclo: $name)"
  ;;

push)
  ref="$(cycle_ref)"
  # guardiano 1: lavoro fatto? (sporco vs R₁ = bene; pulito = niente da pushare)
  if [[ -n "$ref" ]]; then
    mine="$(changes "$WD/" "$ref/")"
    [[ -z "$mine" ]] && { echo "ℹ️  workingdir identica al riferimento: niente da pushare."; exit 0; }
  fi
  # guardiano 2: drift non visto?
  last="$(latest)"
  if [[ -n "$last" ]]; then
    drift="$(changes "$REMOTE_URL" "$last/")"
    if [[ -n "$drift" ]]; then
      echo "⚠️  Il server è cambiato da dopo la tua ultima foto (le sue versioni verranno salvate nel push):"
      echo "$drift" | head -20 | sed 's/^/   /'
      ask "Procedere comunque col push (sovrascrive il server)?" || { echo "abortito — valuta: wsync diff, pull e merge, poi riprova"; exit 1; }
    fi
  fi
  # push con paracadute integrato: ciò che viene sovrascritto/cancellato sul
  # server finisce in staging-<ts>, che diventerà foto -E
  stage="$STAGE_PARENT/wsync-staging-$(TS)"
  # NOTA: --backup-dir è un path LATO RICEVENTE: mai prefisso host:
  rsync -a --delete --backup --backup-dir="$stage" "${EXCLUDES[@]}" "$WD/" "$REMOTE_URL"
  # vittime?
  victims=0
  if rsh "test -d '$stage' -a -n \"\$(ls -A '$stage' 2>/dev/null)\""; then
    name="server-$(TS)-E"; prev="$(latest)"; link=()
    [[ -n "$prev" ]] && link=(--link-dest="$prev")
    mkdir -p "$BASE/$name"
    rsync -a "${link[@]}" "$(RPATH "$stage")/" "$BASE/$name/"   # qui sì host: (sorgente locale)
    victims=$(rsh "find '$stage' -type f | wc -l")
    rsh "rm -rf '$stage'"
    echo "🚨 $victims file del server sono stati sostituiti durante il push → recuperati in: $name"
  else
    rsh "rm -rf '$stage' 2>/dev/null" || true
  fi
  # traguardo: foto del mondo riconciliato, data = push
  name="push-$(TS)"; photo "$name" "$WD/"
  echo "$BASE/$name" > "$CYCLE"
  echo "✅ push ok → 🏁 $name (vittime: $victims)"
  ;;

show)
  # wsync show <file> [snapshot1 snapshot2]  — default: ultima foto vs workingdir
  [[ $# -lt 2 ]] && { echo "uso: wsync show <file> [snapA snapB]"; exit 1; }
  f="$2"
  if [[ $# -ge 4 ]]; then a="$BASE/$2"; b="$BASE/$3"; else a="$(latest)"; b="$WD"; fi
  fa="$a/$f"; fb="$b/$f"
  [[ -e "$fa" ]] || { echo "(non presente in ${a#$BASE/})"; fa=/dev/null; }
  [[ -e "$fb" ]] || { echo "(non presente in ${b#$BASE/})"; fb=/dev/null; }
  diff -u "$fa" "$fb" && echo "(identici)" || true
  ;;

hist)
  for d in "$BASE"/{server-*,push-*,local-*}; do
    [[ -d "$d" ]] || continue
    n="${d#$BASE/}"
    t=$(basename "$n" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{6}')
    case "$n" in
      push-*)     echo "$t  🏁 $n" ;;
      *-E)        echo "$t  🚨 $n  (vittime di un push)" ;;
      server-*)   echo "$t  📷 $n" ;;
      local-*)    echo "$t  🛟 $n  (salvataggio d'emergenza)" ;;
    esac
  done | sort -k3
  ;;

diff-snap)
  [[ $# -lt 3 ]] && { echo "uso: wsync diff-snap <snapA> <snapB>"; exit 1; }
  a=$(ls -1d "$BASE"/*"$2"* | head -1); b=$(ls -1d "$BASE"/*"$3"* | head -1)
  [[ -z "$a" || -z "$b" ]] && { echo "snapshot non trovati"; exit 1; }
  echo "diff: ${a#$BASE/} ↔ ${b#$BASE/}"
  diff -rq "$a" "$b" 2>/dev/null || true
  ;;

keep)
  n="${2:-$KEEP}"
  _byts "$BASE"/{server-*,push-*,local-*} 2>/dev/null | head -n -"$n" | sed 's/^[^ ]*  //' | { xargs -r rm -rf || true; }
  echo "🧹 conservati gli ultimi $n snapshot"
  ;;

repair)
  leftovers="$(rsh "ls -d '$STAGE_PARENT'/wsync-staging-* 2>/dev/null" || true)"
  if [[ -z "$leftovers" ]]; then echo "✅ nessun residuo di push sul server"; exit 0; fi
  echo "⚠️  trovo staging residui (push interrotti?):"; echo "$leftovers" | sed 's/^/   /'
  if ask "Li recupero come foto -E e pulisco il server?"; then
    for s in $leftovers; do
      name="server-$(TS)-E-recovered"
      mkdir -p "$BASE/$name"; rsync -a "$(RPATH "$s")/" "$BASE/$name/"
      rsh "rm -rf '$s'"; echo "🚨 recuperati in $name"
    done
  else
    if ask "Buttarli via? (perdita definitiva)"; then for s in $leftovers; do rsh "rm -rf '$s'"; done; fi
  fi
  ;;

*)
  cat <<'Uso'
wsync — cartella magica: workingdir/ + nastro snapshot + sync ssh

  wsync init                    verifica host/percorso e prepara workingdir
  wsync pull                    server → workingdir (+foto R₁ di ciclo)
  wsync status                  i TUOI cambi vs riferimento del ciclo (istantaneo)
  wsync diff                    deriva del server (+foto se c'è) + status
  wsync push                    workingdir → server (vittime → -E) + 🏁 push-<ts>
  wsync show <file>             diff di un file (foto↔workingdir o tra snap)
  wsync hist                    nastro di tutte le foto
  wsync diff-snap A B           differenze tra due snapshot
  wsync keep [N]                potatura snapshot
  wsync repair                  recupera/pulisce staging residui sul server

  Variabili: WSYNC_YES=1 per risposte automatiche (uso non interattivo)
Uso
  ;;
esac
